<p style="font-size: 16px; color: #1e293b; margin: 0 0 20px;">Hi <%= @resource.name %>,</p>

<% account_user = @resource&.account_users&.first %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <p style="color: #475569; margin: 0 0 16px;"><strong><%= account_user.inviter.name %></strong>, with <strong><%= account_user.account.name %></strong>, has invited you to join <%= global_config['BRAND_NAME'] || 'FlowChat' %>.</p>
<% end %>

<% if @resource.confirmed? %>
  <p style="color: #475569; margin: 0 0 24px;">You can login to your <%= global_config['BRAND_NAME'] || 'FlowChat' %> account through the button below:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
    <p style="color: #475569; margin: 0 0 16px;">Welcome to <%= global_config['BRAND_NAME'] || 'FlowChat' %>! We have a suite of powerful tools ready for you to explore.</p>
    <p style="color: #475569; margin: 0 0 24px;">Before that, we need to quickly verify your email address.</p>
  <% else %>
    <p style="color: #475569; margin: 0 0 24px;">Please click the button below to activate your account.</p>
  <% end %>
<% end %>

<% if @resource.unconfirmed_email.present? %>
  <table cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
    <tr>
      <td align="center" style="background: linear-gradient(135deg, #0ea5e9, #14b8a6); border-radius: 8px;">
        <a href="<%= frontend_url('auth/confirmation', confirmation_token: @token) %>" style="display: inline-block; padding: 12px 32px; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;">Confirm my account</a>
      </td>
    </tr>
  </table>
<% elsif @resource.confirmed? %>
  <table cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
    <tr>
      <td align="center" style="background: linear-gradient(135deg, #0ea5e9, #14b8a6); border-radius: 8px;">
        <a href="<%= frontend_url('auth/sign_in') %>" style="display: inline-block; padding: 12px 32px; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;">Login to my account</a>
      </td>
    </tr>
  </table>
<% elsif account_user&.inviter.present? %>
  <table cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
    <tr>
      <td align="center" style="background: linear-gradient(135deg, #0ea5e9, #14b8a6); border-radius: 8px;">
        <a href="<%= frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %>" style="display: inline-block; padding: 12px 32px; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;">Confirm my account</a>
      </td>
    </tr>
  </table>
<% else %>
  <table cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
    <tr>
      <td align="center" style="background: linear-gradient(135deg, #0ea5e9, #14b8a6); border-radius: 8px;">
        <a href="<%= frontend_url('auth/confirmation', confirmation_token: @token) %>" style="display: inline-block; padding: 12px 32px; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;">Confirm my account</a>
      </td>
    </tr>
  </table>
<% end %>

<p style="font-size: 13px; color: #94a3b8; margin: 16px 0 0; border-top: 1px solid #e2e8f0; padding-top: 16px;">If you didn't request this, you can safely ignore this email.</p>
